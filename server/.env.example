# Copy these files and fill in real values. Never commit the real .env.
# Secrets are intentionally NOT here; they come from Render secret files or
# environment variables.

# Ports exposed on the host
CLIENT_PORT=3000
SERVER_PORT=5001
MONGO_EXPRESS_PORT=8081

# Origin allowed by the API CORS policy
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Client build-time API base URL (public config, not a secret)
# /api/v1 works through the nginx reverse proxy; use an absolute URL
# (e.g. https://api.example.com/api/v1) when the API is on another host.
VITE_API_BASE_URL=/api/v1

# Token lifetimes
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Host-mode server only (`pnpm dev:server`). The containerised server reads
# server/secrets/mongo_uri.txt via MONGO_URI_FILE instead.
# Never commit a real credential here: .env.example holds placeholders only.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/intellmeet?retryWrites=true&w=majority

# Object storage (Backblaze B2, S3-compatible). The API reads and signs URLs
# against this bucket; the browser only ever receives presigned URLs.
# AWS_ENDPOINT_URL: endpoint the SERVER uses for its own calls (HeadObject,
# DeleteObject, reads). Use the B2 S3 host, NOT the f005 download host, so
# presigned PUT responses are accepted by the browser.
AWS_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
# AWS_PUBLIC_ENDPOINT_URL: endpoint a browser uses for presigned download URLs.
# Defaults to AWS_ENDPOINT_URL when unset.
AWS_PUBLIC_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
# B2 details. Fill the real bucket and keys in server/.env.local (never committed).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=intellmeet-bucket
# Optional browser origins for the B2 CORS rule applied by
# server/scripts/_tmp_apply_cors.mjs. Defaults cover the Vercel app and local dev.
# B2_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ── AI pipeline (transcription + summarisation) ───────────────────────────
# Hosted free tiers: no model weights are downloaded and no AI container runs.
# Leave the keys blank to disable a stage; the server still starts without them.
#
# GROQ_API_KEY  -> whisper-large-v3, turns the recording into a transcript.
# OPENROUTER_API_KEY -> free text model, turns the transcript into a summary.
#
# AI keys are read from <NAME>_FILE first (Render secret file), then <NAME>.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides. Defaults are a verified free model plus fallbacks that are
# tried in order when the primary is rate-limited.
# OPENROUTER_SUMMARY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,poolside/laguna-s-2.1:free
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3
# Language sent to Whisper. English avoids noise being detected as another
# language and transliterated. Use "auto" for per-recording detection.
# GROQ_TRANSCRIBE_LANGUAGE=en

# ── Clerk Authentication ───────────────────────────────────────────────────
# Used for backend token verification and user email resolution
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
