{
  "name": "intellmeet",
  "private": true,
  "version": "1.0.0",
  "description": "IntellMeet monorepo - API server and web client",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"pnpm -r --filter server dev\" \"pnpm -r --filter client dev\"",
    "dev:server": "pnpm -r --filter server dev",
    "dev:client": "pnpm -r --filter client dev",
    "dev:mob": "concurrently -n server,client -c green,cyan \"pnpm -r --filter server dev\" \"pnpm -r --filter client dev:mob\"",
    "lint": "pnpm -r lint",
    "lint:server": "pnpm -r --filter server lint",
    "lint:client": "pnpm -r --filter client lint",
    "lint:fix": "pnpm -r lint:fix",
    "build": "pnpm -r build",
    "build:server": "pnpm -r --filter server build",
    "build:client": "pnpm -r --filter client build",
    "openapi": "pnpm -r --filter server openapi",
    "secrets:generate": "node server/scripts/generate-secrets.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:tools": "docker compose --profile tools up -d",
    "docker:logs": "docker compose logs -f",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2"
  },
  "packageManager": "pnpm@11.9.0"
}
