meta {
  name: Complete Upload
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/recordings/{{recordingId}}/complete
  body: json
}

body {
  {
    "durationMs": 15020
  }
}

docs {
  Run after the browser has PUT the file. HeadObject is authoritative for
  size and type: whatever the client claimed is ignored. durationMs is
  clamped to the 60s cap. An object that is empty, oversized or the wrong
  type is deleted and the recording is marked FAILED.
}
