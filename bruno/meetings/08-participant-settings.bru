meta {
  name: Set Participant Permissions
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/meetings/{{meetingId}}/participant-settings
  body: json
}

body {
  {
    "participantId": "{{participantId}}",
    "canSendAudio": false,
    "canSendVideo": true,
    "canShareScreen": false,
    "canUseChat": true
  }
}

docs {
  Per-member mic / camera / screen-share / chat toggles. Only a host or
  moderator may call this. Setting canUseChat to false also blocks that
  member from posting questions, answers and poll votes.
}
