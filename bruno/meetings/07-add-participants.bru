meta {
  name: Add Participants
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/meetings/{{meetingId}}/participants
  body: json
}

body {
  {
    "participantIds": ["{{participantId}}"]
  }
}

script:post-response {
  const data = res.getBody()?.data ?? {};
  const me = data.participants?.find((p) => p.userId === "{{participantId}}");
  if (me) bru.setVar("participantId", me.userId);
}

docs {
  Host or moderator only. A user who is in the organization but NOT in the
  project is rejected with 400, which is the invite-code-bypass rule.
}
