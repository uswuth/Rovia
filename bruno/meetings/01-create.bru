meta {
  name: Schedule Meeting
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/meetings
  body: json
}

body {
  {
    "projectId": "{{projectId}}",
    "meetingTitle": "Sprint Planning",
    "meetingDescription": "Weekly planning sync",
    "meetingScheduledAt": "2026-10-05T10:00:00.000Z",
    "meetingDurationMinutes": 30,
    "meetingJoinMode": "INVITE_ONLY",
    "meetingParticipantLimit": 10,
    "participantIds": []
  }
}

script:post-response {
  const data = res.getBody()?.data ?? {};
  if (data.meetingId) bru.setVar("meetingId", data.meetingId);
  if (data.meetingJoinCode) bru.setVar("meetingJoinCode", data.meetingJoinCode);
}

docs {
  participantIds must all be members or hosts of the project. An org invite
  code does NOT qualify someone. meetingParticipantLimit defaults to 50 and
  can only be lowered, so 10 is valid and 60 is rejected.
}
