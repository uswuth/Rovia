meta {
  name: Vote in Poll
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/meetings/{{meetingId}}/polls/{{pollId}}/vote
  body: json
}

body {
  {
    "optionIds": ["{{optionIdOne}}"]
  }
}

docs {
  Run this twice to prove votes do not double count: re-voting REPLACES your
  previous selection. On a single-choice poll sending two optionIds returns 400.
}
