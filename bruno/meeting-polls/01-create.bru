meta {
  name: Create Poll
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/meetings/{{meetingId}}/polls
  body: json
}

body {
  {
    "pollQuestion": "Which day should we ship?",
    "options": ["Monday", "Friday", "Next sprint"],
    "multipleChoice": false
  }
}

script:post-response {
  const data = res.getBody()?.data ?? {};
  if (data.pollId) bru.setVar("pollId", data.pollId);
  const options = data.pollOptions ?? [];
  if (options[0]?.optionId) bru.setVar("optionIdOne", options[0].optionId);
  if (options[1]?.optionId) bru.setVar("optionIdTwo", options[1].optionId);
}

docs {
  Host or moderator only. 2-10 options. The response exposes voteCount but
  never the list of voter ids, so a poll cannot be used to identify voters.
}
