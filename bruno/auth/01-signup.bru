meta {
  name: Sign Up (create org)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  body: json
  auth: none
}

body {
  {
    "userName": "Bruno Tester",
    "userEmail": "bruno.tester@example.com",
    "password": "Passw0rd!23",
    "isCreatingOrg": true,
    "organizationName": "Bruno Org",
    "organizationSlug": "bruno-org"
  }
}

script:post-response {
  const body = res.getBody();
  const data = body?.data ?? {};
  if (data.accessToken) bru.setVar("accessToken", data.accessToken);
  if (data.user?.organizationId?.organizationId) {
    bru.setVar("organizationId", data.user.organizationId.organizationId);
  }
}

docs {
  Requires isCreatingOrg: true, otherwise the user is created with no
  organization and every tenant-scoped call fails with
  "User must belong to an organization".
}
