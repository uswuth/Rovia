meta {
  name: Ask Question
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/meetings/{{meetingId}}/questions
  body: json
}

body {
  {
    "questionText": "Should we ship the recording pipeline on Friday?"
  }
}

script:post-response {
  const data = res.getBody()?.data ?? {};
  if (data.questionId) bru.setVar("questionId", data.questionId);
}

docs {
  Requires roster membership AND canUseChat. A participant whose chat was
  disabled by a host gets 403 here.
}
