meta {
  name: Answer Question
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/meetings/{{meetingId}}/questions/{{questionId}}/answers
  body: json
}

body {
  {
    "answerText": "No, we ship Monday. The AI summary is still local-only."
  }
}

docs {
  The answer author is taken from the access token, never from the body, so
  a client cannot post an answer attributed to someone else.
}
