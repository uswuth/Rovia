  "cards": [
    {
      "dot": "cyan",
      "title": "Browser",
      "items": [
        "React 19 SPA served by nginx with /api reverse-proxied to the server",
        "A/V media flows peer-to-peer — Socket.io relays only SDP and ICE",
        "Link guests preview the meeting in the lobby before joining"
      ]
    },
    {
      "dot": "emerald",
      "title": "Server",
      "items": [
        "One JWT access token authenticates both REST and the socket handshake",
        "Every query is tenant-scoped from the verified JWT, never the request body",
        "meeting:join re-checks INVITE_ONLY roster before admitting a socket"
      ]
    },
    {
      "dot": "violet",
      "title": "Data & AI",
      "items": [
        "Browser uploads straight to storage via presigned PUT; HeadObject decides type and size",
        "Local Whisper + Ollama generate transcripts and summaries — no external AI API",
        "recordings, transcripts and summaries persist in MongoDB only"
      ]
    }
  ]
